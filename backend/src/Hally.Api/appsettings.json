{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Name": "Hally",
    "PublicBaseUrl": "http://localhost:8080"
  },
  "ConnectionStrings": {
    "Hally": ""
  },
  "Jwt": {
    "Issuer": "hally-api",
    "Audience": "hally-app",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 60
  },
  "ExternalAuth": {
    "GoogleClientIds": [],
    "AppleAudiences": [],
    "EnableDevProvider": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Ai": {
    "BaseUrl": "",
    "ApiKey": "",
    "VisionModel": "",
    "TimeoutSeconds": 60
  },
  "Billing": {
    "GraceDays": 3,
    "TrialDays": 7,
    "SandboxPurchases": false
  },
  "Privacy": {
    "AiProviderNoTraining": false,
    "AiProviderName": "",
    "ContactEmail": "",
    "PolicyUrl": ""
  },
  "Storage": {
    "Root": "./data/documents",
    "EncryptionKey": "",
    "RetentionDays": 30
  }
}
