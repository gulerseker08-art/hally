{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "App": { "Name": "Hally", "PublicBaseUrl": "http://localhost:8080" },
  "ConnectionStrings": { "Hally": "" },
  "Jwt": { "Issuer": "hally-api", "Audience": "hally-app", "SigningKey": "", "AccessTokenMinutes": 30, "RefreshTokenDays": 60 },
  "ExternalAuth": { "GoogleClientIds": [], "AppleAudiences": [], "EnableDevProvider": false },
  "Database": { "MigrateOnStartup": false }
}
