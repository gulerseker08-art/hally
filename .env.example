# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=hally
POSTGRES_PASSWORD=change-me
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://localhost:8080
# Google OAuth client id(s) accepted as ID token audience
GOOGLE_CLIENT_ID=
# Apple Services ID or iOS bundle id
APPLE_AUDIENCE=
# Developer sign-in (dev:{email}:{name}); honoured only when ASPNETCORE_ENVIRONMENT=Development
ENABLE_DEV_SIGN_IN=true
ASPNETCORE_ENVIRONMENT=Development
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts captured photos at rest.
STORAGE_ENCRYPTION_KEY=
# Any OpenAI-compatible endpoint with vision + json_schema structured output. Never put this key in the mobile app.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_VISION_MODEL=
# Push via Firebase Cloud Messaging (optional; empty = pushes are only logged). The service account JSON is a secret.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
