# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=hally
POSTGRES_PASSWORD=change-me
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://localhost:8080
# Google OAuth client id(s) accepted as ID token audience
GOOGLE_CLIENT_ID=
# Apple Services ID or iOS bundle id
APPLE_AUDIENCE=
# Developer sign-in (dev:{email}:{name}); honoured only when ASPNETCORE_ENVIRONMENT=Development
ENABLE_DEV_SIGN_IN=true
ASPNETCORE_ENVIRONMENT=Development
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts captured photos at rest.
STORAGE_ENCRYPTION_KEY=
# Any OpenAI-compatible endpoint with vision + json_schema structured output. Never put this key in the mobile app.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_VISION_MODEL=
# Optional: a cheaper/faster model for the assistant chat (tool calling). Defaults to AI_VISION_MODEL.
AI_CHAT_MODEL=
# Push via Firebase Cloud Messaging (optional; empty = pushes are only logged). The service account JSON is a secret.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Subscriptions (Family Plus). Without store credentials purchases cannot be verified (the trial still works).
# BILLING_SANDBOX=true accepts "sandbox:<product>:<ref>" tokens, only in Development.
BILLING_SANDBOX=true
APPLE_BUNDLE_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# App Store Connect API key (.p8 PEM). Secret.
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_ENVIRONMENT=Sandbox
GOOGLE_PLAY_PACKAGE_NAME=
# Service account JSON with Android Publisher access. Secret.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Random string appended as ?token= to the Pub/Sub push URL. Secret.
GOOGLE_PLAY_NOTIFICATION_TOKEN=
